  "expect": {
    "method": "POST",
    "path": "/api/v2/convert/zpl/to/dpl",
    "headers": {
      "content-type": "text/plain",
      "accept": "*/*"
    },
    "headersAbsent": [
      "authorization"
    ],
    "headersMatch": {
      "user-agent": "^labelzoom-[a-z0-9]+-sdk/"
    },
    "bodyText": "^XA^FO20,20^A0N,28^FDhi^FS^XZ",
    "queryAbsent": [
      "params"
    ]
  }
}
