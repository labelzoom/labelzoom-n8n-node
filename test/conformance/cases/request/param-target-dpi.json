{
  "id": "request/param-target-dpi",
  "note": "C2/C8: the target stage's dpi is the resolution of the output, and travels as targetDpi. The legacy dpi key is never sent.",
  "given": {
    "client": {
      "apiKey": null
    },
    "source": "zpl",
    "target": "png",
    "bodyText": "^XA^FO20,20^A0N,28^FDhi^FS^XZ",
    "options": {
      "targetDpi": 300
    }
  },
  "expect": {
    "method": "POST",
    "path": "/api/v2/convert/zpl/to/png",
    "headers": {
      "content-type": "text/plain",
      "accept": "*/*"
    },
    "headersAbsent": [
      "authorization"
    ],
    "headersMatch": {
      "user-agent": "^labelzoom-[a-z0-9]+-sdk/"
    },
    "bodyText": "^XA^FO20,20^A0N,28^FDhi^FS^XZ",
    "queryJson": {
      "params": {
        "targetDpi": 300
      }
    },
    "queryJsonAbsentKeys": {
      "params": [
        "dpi",
        "sourceDpi"
      ]
    }
  }
}
