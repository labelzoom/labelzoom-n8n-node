{
  "id": "request/no-options-emits-no-query",
  "note": "C7: no options set means no query string at all -- not an empty ?params={}.",
  "given": {
    "client": {
      "apiKey": null
    },
    "source": "zpl",
    "target": "png",
    "bodyText": "^XA^FO20,20^A0N,28^FDhi^FS^XZ"
  },
  "expect": {
    "method": "POST",
    "path": "/api/v2/convert/zpl/to/png",
    "headers": {
      "content-type": "text/plain",
      "accept": "*/*"
    },
    "headersAbsent": [
      "authorization"
    ],
    "headersMatch": {
      "user-agent": "^labelzoom-[a-z0-9]+-sdk/"
    },
    "bodyText": "^XA^FO20,20^A0N,28^FDhi^FS^XZ",
    "queryAbsent": [
      "params"
    ]
  }
}
