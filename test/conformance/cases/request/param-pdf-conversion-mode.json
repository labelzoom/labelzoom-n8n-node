{
  "id": "request/param-pdf-conversion-mode",
  "note": "C2: pdf-conversion-mode travels inside the single ?params= JSON object.",
  "given": {
    "client": {
      "apiKey": null
    },
    "source": "zpl",
    "target": "png",
    "bodyText": "^XA^FO20,20^A0N,28^FDhi^FS^XZ",
    "options": {
      "pdf": {
        "conversionMode": "NATIVE"
      }
    }
  },
  "expect": {
    "method": "POST",
    "path": "/api/v2/convert/zpl/to/png",
    "headers": {
      "content-type": "text/plain",
      "accept": "*/*"
    },
    "headersAbsent": [
      "authorization"
    ],
    "headersMatch": {
      "user-agent": "^labelzoom-[a-z0-9]+-sdk/"
    },
    "bodyText": "^XA^FO20,20^A0N,28^FDhi^FS^XZ",
    "queryJson": {
      "params": {
        "pdf": {
          "conversionMode": "NATIVE"
        }
      }
    }
  }
}
