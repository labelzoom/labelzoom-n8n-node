    "data": [
      {
        "orderNumber": "SO-1001",
        "sku": "A-100"
      }
    ],
    "responses": [
      {
        "status": 503,
        "headers": {
          "content-type": "application/json"
        },
        "bodyText": "{\"message\":\"Service Unavailable\"}"
