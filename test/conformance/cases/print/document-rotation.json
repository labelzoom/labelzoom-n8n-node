{
  "id": "print/document-rotation",
  "note": "P2: rotation turns the finished label, so it is the one target option the printer target stage offers. It travels in params like a source option.",
  "given": {
    "client": {
      "apiKey": "lz_test_print_key"
    },
    "operation": "print",
    "printerId": "5b0e3c1a-8f2d-4c6e-9a7b-1d2e3f4a5b6c",
    "source": "zpl",
    "bodyText": "^XA^FO50,50^A0N,50,50^FDHello^FS^XZ",
    "options": {
      "rotation": 90
    },
    "responses": [
      {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "bodyText": "{\"jobId\":\"9f1c7e2a-4b30-4d6e-8a11-5c2f9d4e7b83\",\"status\":\"dispatched\",\"copies\":null}"
      }
    ]
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/api/v3/printers/5b0e3c1a-8f2d-4c6e-9a7b-1d2e3f4a5b6c/print",
      "headers": {
        "content-type": "text/plain",
        "accept": "application/json",
        "authorization": "Bearer lz_test_print_key"
      },
      "headersMatch": {
        "user-agent": "^labelzoom-[a-z0-9]+-sdk/",
        "idempotency-key": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "query": {
        "sourceFormat": "zpl"
      },
      "queryAbsent": [
        "copies"
      ],
      "bodyText": "^XA^FO50,50^A0N,50,50^FDHello^FS^XZ",
      "queryJson": {
        "params": {
          "rotation": 90
        }
      }
    },
    "result": {
      "printJob": {
        "jobId": "9f1c7e2a-4b30-4d6e-8a11-5c2f9d4e7b83",
        "status": "dispatched",
        "copies": null,
        "idempotent": false
      }
    }
  }
}
