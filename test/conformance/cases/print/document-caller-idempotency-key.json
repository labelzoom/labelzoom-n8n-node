{
  "id": "print/document-caller-idempotency-key",
  "note": "P4: a key the caller sets is sent exactly as given.",
  "given": {
    "client": {
      "apiKey": "lz_test_print_key"
    },
    "operation": "print",
    "printerId": "5b0e3c1a-8f2d-4c6e-9a7b-1d2e3f4a5b6c",
    "source": "zpl",
    "bodyText": "^XA^FO50,50^A0N,50,50^FDHello^FS^XZ",
    "idempotencyKey": "SO-1001",
    "responses": [
      {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "bodyText": "{\"jobId\":\"9f1c7e2a-4b30-4d6e-8a11-5c2f9d4e7b83\",\"status\":\"dispatched\",\"copies\":null}"
      }
    ]
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/api/v3/printers/5b0e3c1a-8f2d-4c6e-9a7b-1d2e3f4a5b6c/print",
      "headers": {
        "content-type": "text/plain",
        "accept": "application/json",
        "authorization": "Bearer lz_test_print_key",
        "idempotency-key": "SO-1001"
      },
      "headersMatch": {
        "user-agent": "^labelzoom-[a-z0-9]+-sdk/"
      },
      "query": {
        "sourceFormat": "zpl"
      },
      "queryAbsent": [
        "params",
        "copies"
      ],
      "bodyText": "^XA^FO50,50^A0N,50,50^FDHello^FS^XZ"
    },
    "result": {
      "printJob": {
        "jobId": "9f1c7e2a-4b30-4d6e-8a11-5c2f9d4e7b83",
        "status": "dispatched",
        "copies": null,
        "idempotent": false
      }
    }
  }
}
